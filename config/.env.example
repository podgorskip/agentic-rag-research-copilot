
# Local Qdrant infrastructure (docker-compose.yml)
QDRANT_VERSION=v1.13.6
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Application connection to Qdrant
RAG_QDRANT_URL=http://localhost:6333
RAG_QDRANT_COLLECTION=chunks

# Embeddings (Ollama)
RAG_OLLAMA_URL=http://localhost:11434
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_EMBEDDING_BATCH_SIZE=32
RAG_EMBEDDING_TIMEOUT_SECONDS=120

# Chunking
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200

# Agent (LLM)
RAG_LLM_PROVIDER=ollama
RAG_LLM_MODEL=llama3.2
RAG_LLM_TIMEOUT_SECONDS=120
RAG_MAX_LOOP_COUNT=3

# API
RAG_API_HOST=127.0.0.1
RAG_API_PORT=8000
RAG_API_CORS_ORIGINS=["http://localhost:8501"]
RAG_API_MAX_UPLOAD_BYTES=52428800

# Observability (Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
